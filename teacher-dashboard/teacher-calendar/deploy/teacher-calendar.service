[Unit]
Description=Teacher Calendar Web App (port 8787)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/apps/teacher-calendar
ExecStart=/usr/bin/node server/index.mjs
Environment=PORT=8787
Environment=HOST=0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
