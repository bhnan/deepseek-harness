{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:viz/line",
  "title": "Line",
  "description": "viz_block：时序/净值曲线。以 DojoAgents 后端 _generic_line 为准：payload.series[{id,label,points[{date,value}]}] + benchmark_series?。",
  "type": "object",
  "required": ["kind", "payload"],
  "properties": {
    "kind": { "const": "line" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "source_tool": { "type": "string" },
    "truncated": { "type": "boolean" },
    "payload": {
      "type": "object",
      "required": ["series"],
      "properties": {
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "points"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["date", "value"],
                  "properties": {
                    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                    "value": { "type": "number", "description": "必须为有限数" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "benchmark_series": {
          "type": "array",
          "description": "基准序列，结构与 series 相同",
          "items": {
            "type": "object",
            "required": ["id", "label", "points"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["date", "value"],
                  "properties": {
                    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                    "value": { "type": "number" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
