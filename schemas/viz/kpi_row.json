{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:viz/kpi_row",
  "title": "KpiRow",
  "description": "viz_block：指标行。信封与 payload 以 DojoAgents 后端运行时（agent_viz.py _block + _generic_kpi_row）为准，非 prompt 示例：payload.items[]，tone 枚举 positive/negative/neutral（prompt 里叫 trend 是差异）。",
  "type": "object",
  "required": ["kind", "payload"],
  "properties": {
    "kind": { "const": "kpi_row" },
    "id": { "type": "string", "description": "后端生成 12 位 hex；生产者未给时前端自动补" },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "source_tool": { "type": "string" },
    "truncated": { "type": "boolean" },
    "payload": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": ["string", "number"], "description": "格式化值（如 '+12.3%'）或数值" },
              "value_format": { "type": "string", "description": "percent/number/market_cap 等，可选" },
              "meta": { "type": "string" },
              "delta": { "type": ["string", "number"] },
              "tone": { "type": "string", "enum": ["positive", "negative", "neutral"] }
            },
            "additionalProperties": false
          }
        },
        "layout": { "const": "by_market" },
        "markets": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
