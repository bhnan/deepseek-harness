{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:viz/bar",
  "title": "Bar",
  "description": "viz_block：分类对比柱状图。以 DojoAgents 后端 _generic_bar 为准：payload.series[{name,label,values}]（name 与 label 并存）。",
  "type": "object",
  "required": ["kind", "payload"],
  "properties": {
    "kind": { "const": "bar" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "source_tool": { "type": "string" },
    "truncated": { "type": "boolean" },
    "payload": {
      "type": "object",
      "required": ["categories", "series"],
      "properties": {
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "values"],
            "properties": {
              "name": { "type": "string", "description": "系列标识，可选" },
              "label": { "type": "string" },
              "values": { "type": "array", "minItems": 1, "items": { "type": "number" }, "description": "长度与 categories 一致" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
