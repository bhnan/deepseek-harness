{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:lifecycle/signal",
  "title": "Signal",
  "description": "信号：可执行的命题。statement 给人看（澄清结果、季度 review 读它）、expression 给机器跑（DSL）。澄清过程发生在 DSH 会话中，不留 Schema。定义对象，版本化存储（修改生成新版本，不覆盖）。",
  "type": "object",
  "required": ["id", "version", "idea_id", "statement", "expression"],
  "properties": {
    "id": { "type": "string", "pattern": "^signal_\\w+$" },
    "version": { "type": "integer", "minimum": 1 },
    "idea_id": { "type": "string", "description": "回链 Idea" },
    "name": { "type": "string", "description": "机器友好的短名，如 oversold_volume_reversal" },
    "statement": { "type": "string", "description": "一句话命题（必填）：条件 → 预测 + 窗口 + 基准。如'银行指数20日涨幅>5%且科技指数20日跌幅>5%时，未来10日科技相对银行收益为负'" },
    "description": { "type": "string" },
    "expression": {
      "$ref": "#/$defs/expr",
      "description": "Signal DSL（v0 三类表达式）。语法护栏：禁止未来引用（前视窗口一律非法）"
    },
    "parameters": {
      "type": "object",
      "description": "可调参数及默认值，如 {\"lookback\": 20, \"threshold\": 0.05}",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "required_fields": { "type": "array", "items": { "type": "string" }, "description": "计算所需数据字段，如 [\"close\",\"volume\"]" },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
    "lookback_period": { "type": "integer", "minimum": 1, "description": "计算所需的最大回看窗口（交易日）" }
  },
  "$defs": {
    "expr": {
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        { "$ref": "#/$defs/node" }
      ]
    },
    "leaf": {
      "type": "object",
      "required": ["metric", "op", "value"],
      "properties": {
        "metric": { "type": "string", "description": "v0 三类：指标（return/ma/volume_ratio）、横截面（rank）、事件（notice_date）" },
        "args": { "type": "object", "additionalProperties": true },
        "op": { "type": "string", "enum": [">", "<", ">=", "<=", "==", "!=", "cross_above", "cross_below"] },
        "value": { "type": ["number", "string"] }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["operator", "conditions"],
      "properties": {
        "operator": { "type": "string", "enum": ["AND", "OR", "NOT"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expr" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
