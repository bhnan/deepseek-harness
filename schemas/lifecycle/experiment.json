{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:lifecycle/experiment",
  "title": "Experiment",
  "description": "实验：核心调度对象，描述'我要验证什么'。≠ BacktestRun（一次实验实际运行发生了什么）。执行对象，写定后不可变。",
  "type": "object",
  "required": ["id", "signal_id", "signal_version", "purpose", "dataset_config_id", "period", "evaluation_plan_id", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^exp_\\w+$" },
    "signal_id": { "type": "string" },
    "signal_version": { "type": "integer", "minimum": 1 },
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "integer", "minimum": 1, "description": "purpose=signal_validation 时可为空（只验信号不验交易）" },
    "purpose": {
      "type": "string",
      "enum": ["signal_validation", "strategy_backtest", "parameter_search", "robustness_test", "forward_tracking"],
      "description": "forward_tracking=前向跟踪（最终裁判），跟踪快照见 contracts/tracking.json"
    },
    "dataset_config_id": { "type": "string", "description": "引用 Dataset 配置（数据版本/复权/日历）" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "in_sample_end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "样本内外分界（护栏 E1）" }
      },
      "additionalProperties": false
    },
    "parameter_overrides": { "type": "object", "additionalProperties": true },
    "evaluation_plan_id": { "type": "string", "description": "引用统一评价计划（默认 eval_default，见 evaluation.json）" },
    "status": { "type": "string", "enum": ["created", "queued", "running", "completed", "failed"] }
  },
  "additionalProperties": false
}
