{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:assets/sw_l1_spot",
  "title": "SwL1Spot",
  "description": "A6 申万一级行业。industries[] 由两个源按代码 join：index_realtime_sw（指数代码/名称/昨收盘/今开盘/最新价/成交额/成交量/最高价/最低价，源单位：百万元/百万股）+ sw_index_first_info（行业代码带 .SI 后缀/行业名称/成份个数/静态市盈率/TTM(滚动)市盈率/市净率/静态股息率）。两侧字段均原样透传。derived.change_pct = 涨跌幅（源没有，管道自算）。",
  "type": "object",
  "required": ["schema_version", "data"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d{1,2}\\.\\d{1,3}$" },
    "data_quality": {
      "type": "object",
      "properties": {
        "missing": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "required": ["industries"],
      "properties": {
        "industries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["指数代码", "指数名称", "最新价", "derived"],
            "properties": {
              "指数代码": { "type": "string", "pattern": "^801\\d{3}$", "description": "index_realtime_sw 原值" },
              "指数名称": { "type": "string" },
              "昨收盘": { "type": "number" },
              "今开盘": { "type": "number" },
              "最新价": { "type": "number" },
              "成交额": { "type": "number", "description": "源单位：百万元" },
              "成交量": { "type": "number", "description": "源单位：百万股" },
              "最高价": { "type": "number" },
              "最低价": { "type": "number" },
              "行业代码": { "type": "string", "pattern": "^801\\d{3}\\.SI$", "description": "sw_index_first_info 原值（带 .SI）" },
              "行业名称": { "type": "string" },
              "成份个数": { "type": "integer" },
              "静态市盈率": { "type": "number" },
              "TTM(滚动)市盈率": { "type": "number" },
              "市净率": { "type": "number" },
              "静态股息率": { "type": "number" },
              "derived": {
                "type": "object",
                "description": "derived 层：本系统算出来的字段",
                "required": ["change_pct"],
                "properties": {
                  "change_pct": { "type": "number", "description": "涨跌幅 %，(最新价-昨收盘)/昨收盘" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
