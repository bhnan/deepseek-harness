{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading:assets/portfolio",
  "title": "Portfolio",
  "description": "A11 组合（前端需求 4.4）。呈现方式与板块（sw_l1_spot）对齐：组合 = 一批股票的组合 = 聚合实体（当前值=总市值/净值、当日涨跌幅、净值曲线≈板块动量曲线、持仓≈板块成分股）。源 = paper_trading/state/portfolio.json + nav.csv，其字段原样透传；derived 层 = 管道结合当日收盘快照算出。",
  "type": "object",
  "required": ["schema_version", "data"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d{1,2}\\.\\d{1,3}$" },
    "data_quality": {
      "type": "object",
      "properties": {
        "missing": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "required": ["cash", "start_date", "initial_nav", "positions", "derived"],
      "properties": {
        "cash": { "type": "number", "description": "paper_trading state 原字段：现金" },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "state 原字段：模拟盘起始日" },
        "initial_nav": { "type": "number", "description": "state 原字段：初始净值" },
        "positions": {
          "type": "array",
          "description": "持仓（≈ 板块成分股）",
          "items": {
            "type": "object",
            "required": ["position_id", "strategy", "symbol", "name", "shares", "entry_price", "entry_date", "target_exit_date", "stop_loss_price", "stop_loss_window_end", "entry_cost", "derived"],
            "properties": {
              "position_id": { "type": "string", "description": "state 原字段" },
              "strategy": { "type": "string", "description": "state 原字段：触发假设编号 H001/H005..." },
              "symbol": { "type": "string", "description": "state 原字段：股票代码（state 里什么形态就什么形态）" },
              "name": { "type": "string" },
              "shares": { "type": "number", "description": "股数" },
              "entry_price": { "type": "number", "description": "入场价" },
              "entry_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "target_exit_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "60 交易日后目标退出日" },
              "stop_loss_price": { "type": "number", "description": "止损价" },
              "stop_loss_window_end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "止损窗口截止日" },
              "entry_cost": { "type": "number", "description": "买入手续费" },
              "notes": { "type": "string", "description": "state 原字段，可为空串" },
              "derived": {
                "type": "object",
                "description": "derived 层：管道结合当日收盘快照算出",
                "required": ["price", "market_value", "pnl", "pnl_pct", "weight", "status"],
                "properties": {
                  "price": { "type": "number", "description": "现价（当日收盘）" },
                  "market_value": { "type": "number", "description": "市值 = shares × price" },
                  "pnl": { "type": "number", "description": "浮动盈亏 = market_value - shares×entry_price - entry_cost" },
                  "pnl_pct": { "type": "number", "description": "盈亏 %" },
                  "weight": { "type": "number", "description": "占比 = market_value / 总市值" },
                  "status": { "type": "string", "enum": ["normal", "near_stop", "stopped"], "description": "现价 vs 止损价判定" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "derived": {
          "type": "object",
          "description": "组合级 derived：当前值/当日涨跌幅/净值曲线（≈ 板块的 最新价+涨跌幅+动量曲线）",
          "required": ["total_value", "change_pct", "nav_history"],
          "properties": {
            "total_value": { "type": "number", "description": "总市值 = cash + Σ market_value（≈ 板块最新价语义）" },
            "change_pct": { "type": "number", "description": "当日净值涨跌 %（nav.csv 最新 nav_pct，≈ 板块涨跌幅）" },
            "nav_history": {
              "type": "array",
              "description": "净值序列（≈ 板块动量曲线），字段 = nav.csv 原字段",
              "items": {
                "type": "object",
                "required": ["date", "nav", "nav_pct", "benchmark_nav", "benchmark_pct", "excess"],
                "properties": {
                  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "nav": { "type": "number" },
                  "nav_pct": { "type": "number" },
                  "benchmark_nav": { "type": "number" },
                  "benchmark_pct": { "type": "number" },
                  "excess": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
